# --- Postgres ---
# En Railway, agregás el plugin Postgres y referenciás su variable:
#   DATABASE_URL = ${{ Postgres.DATABASE_URL }}
# En local, apuntás a tu Postgres:
DATABASE_URL=postgres://user:pass@localhost:5432/youarethead

# --- Wishlist ---
WISHLIST_GOAL=10000

# Salt para hashear las IP (privacidad + dedupe). Poné algo random y largo.
IP_SALT=cambiame-por-un-string-random-largo

# Un alta por IP (true/false). Si lo ponés en false, no se hashea ni se limita por IP.
ONE_PER_IP=true

# SSL de Postgres: auto (default) | require | disable
# Dejalo vacío salvo que sepas que lo necesitás.
# PGSSL=

# Puerto. En Railway se setea solo, no hace falta tocarlo.
# PORT=3000
